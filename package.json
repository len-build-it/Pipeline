{
  "name": "pipeline-org-manager",
  "version": "0.1.0",
  "description": "AqOne and Dev Guild Manager MVP",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "check": "node scripts/check.js",
    "demo": "node server/demo.js",
    "db:migrate": "node db/migrate.js",
    "db:migrate:test": "node db/migrate.js --test",
    "test:auth": "node --test --test-concurrency=1 tests/auth/auth.test.js",
    "test:members": "node --test --test-concurrency=1 tests/members/members.test.js",
    "test:tasks": "node --test --test-concurrency=1 tests/tasks/tasks.test.js",
    "test:announcements": "node --test --test-concurrency=1 tests/announcements/announcements.test.js",
    "test": "npm run test:auth && npm run test:members && npm run test:tasks && npm run test:announcements",
    "test:ui": "playwright test",
    "test:e2e": "playwright test --config=playwright.e2e.config.js",
    "test:performance": "node tests/performance.test.js",
    "test:restore": "node scripts/test-restore.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1"
  }
}
